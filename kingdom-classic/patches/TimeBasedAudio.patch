--- a/unity-web/Assets/Scripts/Assembly-CSharp/TimeBasedAudio.cs
+++ b/unity-web/Assets/Scripts/Assembly-CSharp/TimeBasedAudio.cs
@@ -1 +1,2 @@
+using System.Collections;
 using DG.Tweening;
@@ -18,2 +19,3 @@
 	private float _maxVolume;
+	private Coroutine _startRoutine;
 
@@ -22,3 +24,5 @@
 		_audioSource = Require.Component<AudioSource>(this);
-		_playing = _audioSource.playOnAwake;
+		_audioSource.playOnAwake = false;
+		_audioSource.Stop();
+		_playing = false;
 		_maxVolume = _audioSource.volume;
@@ -57,4 +61,19 @@
 		_playing = true;
-		_audioSource.Play();
+		_audioSource.DOKill();
+		_startRoutine = StartCoroutine(StartWhenReady());
+	}
+
+	private IEnumerator StartWhenReady()
+	{
+		if (_audioSource.clip == null) yield break;
+		if (_audioSource.clip.loadState == AudioDataLoadState.Unloaded) _audioSource.clip.LoadAudioData();
+		while (_audioSource.clip.loadState == AudioDataLoadState.Loading) yield return null;
+		if (_audioSource.clip.loadState != AudioDataLoadState.Loaded) yield break;
+		if (!_audioSource.isPlaying)
+		{
+			_audioSource.volume = 0f;
+			_audioSource.Play();
+		}
 		_audioSource.DOFade(_maxVolume, fadeDuration);
+		_startRoutine = null;
 	}
@@ -64,3 +83,15 @@
 		_playing = false;
-		_audioSource.DOFade(0f, fadeDuration);
+		if (_startRoutine != null) StopCoroutine(_startRoutine);
+		_startRoutine = null;
+		_audioSource.DOKill();
+		_audioSource.DOFade(0f, fadeDuration).OnComplete(() => _audioSource.Stop());
+	}
+
+	private void OnDisable()
+	{
+		StopAllCoroutines();
+		_startRoutine = null;
+		_playing = false;
+		_audioSource.DOKill();
+		_audioSource.Stop();
 	}
