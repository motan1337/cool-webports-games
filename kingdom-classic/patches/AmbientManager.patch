+	private void ApplyEnvironmentVolumes(float windSpeed, float rain)
+	{
+		float wind = Mathf.Lerp(0.5f, 1f, Mathf.Clamp01(Mathf.Abs(windSpeed)));
+		ambientMixer.SetFloat("WindVol", Util.LinearToDecibel(wind));
+		ambientMixer.SetFloat("ForestWindVol", Util.LinearToDecibel(wind));
+		ambientMixer.SetFloat("RainVol", Mathf.Max(-80f, Util.LinearToDecibel(Mathf.Clamp01(rain))));
+	}
+
+	private void ApplyRegionVolumes(float forest, float castle)
+	{
+		forest = Mathf.Clamp01(forest);
+		castle = Mathf.Clamp01(castle);
+		float total = forest + castle;
+		if (total > 1f)
+		{
+			forest /= total;
+			castle /= total;
+		}
+		float meadow = Mathf.Max(0f, 1f - forest - castle);
+		ambientMixer.SetFloat("MeadowVol", -39.928783f * forest - 14.816608f * castle);
+		ambientMixer.SetFloat("ForestVol", -39.928783f * meadow - 80f * castle);
+	}
